<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.StellaConnect" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:statusBarColor">#020305</item>
        <item name="android:navigationBarColor">#020305</item>
        <item name="android:windowBackground">#020305</item>
    </style>

    <!-- Cold-start splash. Shown by the system before the first frame so the
         launch never flashes white/black-then-content. Handed off to
         Theme.StellaConnect by installSplashScreen() once Compose is ready. -->
    <style name="Theme.StellaConnect.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#020305</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_stella_launcher</item>
        <item name="windowSplashScreenAnimationDuration">400</item>
        <item name="postSplashScreenTheme">@style/Theme.StellaConnect</item>
    </style>
</resources>