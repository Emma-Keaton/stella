{
    "name": "skill_update",
    "version": "1.0.0",
    "test_cases": [
        {
            "name": "sources",
            "operation": "sources",
            "expect_ok": true,
            "expect_keys": ["skill_dir", "update_dir", "write_fields", "bump_levels", "signals"]
        },
        {
            "name": "list skills",
            "operation": "list",
            "expect_ok": true,
            "expect_keys": ["skills", "count", "total"]
        },
        {
            "name": "inspect without skill",
            "operation": "inspect",
            "expect_ok": false
        },
        {
            "name": "inspect nonexistent skill",
            "operation": "inspect",
            "skill": "does_not_exist",
            "expect_ok": false
        },
        {
            "name": "record_pref without authorized",
            "operation": "record_pref",
            "skill": "anatomy",
            "signal": "accept",
            "context": "test",
            "expect_ok": false
        },
        {
            "name": "record_pref bad signal",
            "operation": "record_pref",
            "skill": "anatomy",
            "signal": "maybe",
            "context": "test",
            "authorized": true,
            "confirm": true,
            "expect_ok": false
        },
        {
            "name": "bump_version without authorized",
            "operation": "bump_version",
            "skill": "anatomy",
            "expect_ok": false
        },
        {
            "name": "update_manifest unknown field",
            "operation": "update_manifest",
            "skill": "anatomy",
            "field": "nonexistent",
            "value": "x",
            "authorized": true,
            "confirm": true,
            "expect_ok": false
        },
        {
            "name": "rollback without target version",
            "operation": "rollback",
            "skill": "anatomy",
            "authorized": true,
            "confirm": true,
            "expect_ok": false
        },
        {
            "name": "unknown operation",
            "operation": "frobnicate",
            "expect_ok": false
        }
    ]
}
