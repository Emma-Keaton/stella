{
    "name": "writing_plans",
    "version": "1.0.0",
    "test_cases": [
        {
            "name": "sources",
            "operation": "sources",
            "expect_ok": true,
            "expect_keys": ["source", "dependencies", "operations"]
        },
        {
            "name": "create without goal",
            "operation": "create",
            "expect_ok": false
        },
        {
            "name": "create with goal",
            "operation": "create",
            "goal": "build a chat feature",
            "steps": "['design UI', 'implement backend', 'test']",
            "expect_ok": true,
            "expect_keys": ["plan", "note"]
        },
        {
            "name": "list plans",
            "operation": "list",
            "expect_ok": true,
            "expect_keys": ["plans", "count", "total"]
        },
        {
            "name": "update unknown goal",
            "operation": "update",
            "goal": "nonexistent",
            "expect_ok": false
        },
        {
            "name": "unknown operation",
            "operation": "frobnicate",
            "expect_ok": false
        }
    ]
}
