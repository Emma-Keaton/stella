{
    "name": "self_evolution",
    "version": "1.0.0",
    "test_cases": [
        {
            "name": "sources",
            "operation": "sources",
            "expect_ok": true,
            "expect_keys": ["operations", "note"]
        },
        {
            "name": "sources_list",
            "operation": "sources_list",
            "expect_ok": true,
            "expect_keys": ["operations", "note"]
        },
        {
            "name": "backends",
            "operation": "backends",
            "expect_ok": true,
            "expect_keys": ["backends", "note"]
        },
        {
            "name": "evolve without authorized",
            "operation": "evolve",
            "concept": "test concept",
            "expect_ok": false
        },
        {
            "name": "evolve with authorized",
            "operation": "evolve",
            "concept": "test concept",
            "authorized": true,
            "confirm": true,
            "expect_ok": true,
            "expect_keys": ["goal", "initial_score", "final_score", "improvement", "iterations", "turns", "tool_calls", "tools_used", "lessons_learned"]
        },
        {
            "name": "unknown operation",
            "operation": "frobnicate",
            "expect_ok": false
        }
    ]