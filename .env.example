# Stella Backend Environment Variables
# Copy to .env and fill in your values. Never commit .env.

# Application URL (set to your Modal public URL after deployment)
APP_URL=https://your-app.modal.host

# ── AI Provider API Keys (configure via Stella Settings UI or Modal secrets) ──
GEMINI_API_KEY=AIzaSy...
NVIDIA_API_KEY=nvapi-...
OPENROUTER_API_KEY=sk-or-...
OPENAI_API_KEY=sk-...
GROQ_API_KEY=gsk_...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_MAPS_API_KEY=...
LOCAL_GGUF_MODEL_PATH=./models/your-model.gguf

# ── Backend ──
STELLA_HOST=0.0.0.0
STELLA_PORT=8765

# ── Frontend ──
NEXT_PUBLIC_APP_URL=https://your-app.modal.host
NEXT_PUBLIC_WS_URL=wss://your-app.modal.host
